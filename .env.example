# Requires Node.js 24+. Paths are relative to the process working directory.
HOST=127.0.0.1
PORT=3000

# Keep state outside the file root, or inside a reserved .filebrowser-* directory.
FB_STORAGE_ROOT=./data
FB_STATE_DIR=./.filebrowser

# Set these behind your HTTPS reverse proxy.
FB_SECURE_COOKIES=false
# FB_PUBLIC_ORIGIN=https://files.example.com

# Optional verification/performance overrides, in bytes. Default chunk: 100 MiB.
# FB_UPLOAD_CHUNK_SIZE=102400
# The file limit is capped at 12000 chunks and 1 TiB. Omit to calculate it.
# FB_MAX_FILE_SIZE=1073741824
# FB_LOG_LEVEL=warn
# FB_BUILD_COMMIT=local

# Optional PostgreSQL tooling inherited from the starter. The application uses
# durable, local SQLite state and does not require a PostgreSQL server.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filebrowser
