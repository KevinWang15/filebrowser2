# Requires Node.js 24+. Paths are relative to the process working directory.
HOST=127.0.0.1
PORT=3000

# Application state location, configured independently of storage targets.
FB_STATE_DIR=./.filebrowser-state
# Suggestion in the setup wizard only. No storage target exists until configured.
FB_SETUP_LOCAL_PATH=./data
# Initial wizard choice for a physically read-only local mount.
FB_SETUP_LOCAL_READ_ONLY=false
# Configure named local/S3/FTP/SFTP targets and read-only access in the admin UI.

# Set these behind your HTTPS reverse proxy.
FB_SECURE_COOKIES=false
# FB_PUBLIC_ORIGIN=https://files.example.com

# Optional verification/performance overrides, in bytes. Default chunk: 100 MiB.
# FB_UPLOAD_CHUNK_SIZE=102400
# The file limit is capped at 12000 chunks and 1 TiB. Omit to calculate it.
# FB_MAX_FILE_SIZE=1073741824
# FB_LOG_LEVEL=warn
# FB_BUILD_COMMIT=local

# Optional read-only SMB companion. See docs/network-shares.md.
FB_SMB_ENABLED=false
# FB_SMB_CONTROL_DIR=./.filebrowser-state/protocols
# FB_SMB_PUBLIC_HOST=files.example.com
